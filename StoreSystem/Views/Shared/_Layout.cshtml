<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>StoreSystem - @ViewData["Title"]</title>
        <script type="importmap"></script>
        <!-- Bootstrap 5.3.8 -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
        <!-- Bootstrap Icons -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet" />

        <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" />

        <link rel="stylesheet" href="~/css/site.css" asp-="container-fluid" asp-append-version="true" />
        <link rel="stylesheet" href="~/StoreSystem.styles.css" asp-append-version="true" />
    </head>
<body class="d-flex flex-column vh-100">
        <header class="navbar navbar-dark shadow-sm">
            <div class="container-fluid">
                <span class="navbar-brand fw-bold"><i class="bi bi-shop me-2"></i> Store Management System </span>
            </div>
        </header>
        <div class="container-fluid">
            <div class="row">
                <!-- SIDEBAR -->
                <aside class="col-md-2 sidebar p-0">
                    <div class="logo-section">
                        <img src="~/images/seedyhub.png" asp-append-version="true" class="logo-img" alt="Logo" />
                        <h6 class="mt-3 text-white">Inventory System</h6>
                    </div>
                    <div class="px-3 mt-5">
                        <a asp-controller="Home" 
                            asp-action="Index" class="sidebar-link"> 
                            <i class="bi bi-house-door-fill me-2"></i> 
                            DashBoard 
                        </a>   
                        
                        <!-- Item Menu -->
                        <a class="sidebar-link d-flex justify-content-between align-items-center"
                            href="javascript:void(0);"
                            onclick="toggleMenu('itemMenu', this)">

                            <span> <i class="bi bi-box-seam me-2"></i> Item </span>
                            <i class="bi bi-chevron-down menu-arrow"></i>   
                        </a>
                        <div class="submenu-container" id="itemMenu">
                            <a asp-controller="Item" asp-action="Index" class="sidebar-sublink"> 
                                <i class="bi bi-card-list me-2"></i> 
                                List 
                            </a>
                            <a asp-controller="Item" asp-action="Create" class="sidebar-sublink"> 
                                <i class="bi bi-plus-circle me-2"></i> 
                                Add 
                            </a>
                        </div>
                       
                        <!-- Purchase Menu -->
                        <a class="sidebar-link d-flex justify-content-between align-items-center"
                            href="javascript:void(0);"
                            onclick="toggleMenu('purchaseMenu', this)">

                            <span> <i class="bi bi-cart-plus-fill me-2"></i> Purchase </span>
                            <i class="bi bi-chevron-down menu-arrow"></i>
                        </a>
                        <div class="submenu-container" id="purchaseMenu">
                            <a asp-controller="Purchase" asp-action="Index" class="sidebar-sublink">  
                                <i class="bi bi-card-list me-2"></i> 
                                List 
                            </a>
                            <a asp-controller="Purchase"  asp-action="Create" class="sidebar-sublink"> 
                                <i class="bi bi-plus-circle me-2"></i> 
                                Purchase 
                            </a>
                        </div>

                         <!-- Sale Menu -->
                        <a class="sidebar-link d-flex justify-content-between align-items-center"
                            href="javascript:void(0);"
                            onclick="toggleMenu('sellMenu', this)">

                            <span> 
                                <i class="bi bi-cart-dash-fill me-2"></i> 
                                Sale 
                            </span>
                            <i class="bi bi-chevron-down menu-arrow"></i>  
                        </a>
                         <div class="submenu-container" id="sellMenu">
                            <a asp-controller="Sell" 
                                asp-action="Index" 
                                class="sidebar-sublink"> 
                                <i class="bi bi-card-list me-2"></i> 
                                List 
                            </a>
                            <a asp-controller="Sell" 
                                asp-action="Create" 
                                class="sidebar-sublink"> 
                                <i class="bi bi-cash-stack me-2"></i> 
                                Sell 
                            </a>
                        </div>
                        <!-- Reports -->
                        <a class="sidebar-link d-flex justify-content-between align-items-center"
                            href="javascript:void(0);"
                            onclick="toggleMenu('reportsMenu', this)">

                            <span> 
                                <i class="bi bi-bar-chart-fill me-2"></i> 
                                Reports 
                            </span>
                            <i class="bi bi-chevron-down menu-arrow"></i>  
                        </a>
                        <div class="submenu-container" id="reportsMenu">
                            <a asp-controller="#" 
                                asp-action="#" 
                                class="sidebar-sublink"> 
                                <i class="bi bi-card-list me-2"></i> 
                                Sales 
                            </a>
                            <a asp-controller="#" 
                                asp-action="#" 
                                class="sidebar-sublink"> 
                                <i class="bi bi-cash-stack me-2"></i> 
                                Purchases 
                            </a>
                        </div>
                    </div>
                </aside>
                <!-- CONTENT -->
            <main class="col-md-10 content-area flex-column">
                    @RenderBody()
                </main>
            </div>
        </div>
        <footer class="py-2">
            <div class="container-fluid text-center text-white ">
                © @DateTime.Now.Year Store System  
            </div>
        </footer>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>

        <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

        <script src="~/js/site.js" asp-append-version="true"></script>

        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>
