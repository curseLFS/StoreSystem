@using StoreSystem.DAL.Dto
@model IEnumerable<ItemInventoryDto>

@{
    ViewData["Title"] = "Item";
}

<link href="~/css/item/index.css" rel="stylesheet" />

<div class="card shadow-sm">
    <div class="card-header inventory-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h3 class="mb-0">
                    <i class="bi bi-box-seam me-2"></i>
                    Inventory Management
                </h3>
                <small>Track item stock and movements</small>
            </div>

            <a asp-controller="Item"
               asp-action="Create"
               class="btn btn-light">
                <i class="bi bi-plus-circle me-1"></i>
                Add Item
            </a>
        </div>
    </div>

    <div class="card-body">
        <div class="row mb-4">

            <div class="col-md-4">
                <div class="mini-stat bg-success text-white">
                    <h6>Total Items</h6>
                    <h3>@Model.Count()</h3>
                </div>
            </div>

            <div class="col-md-4">
                <div class="mini-stat bg-primary text-white">
                    <h6>Total Purchased</h6>
                    <h3>@Model.Sum(x => x.TotalPurchased)</h3>
                </div>
            </div>

            <div class="col-md-4">
                <div class="mini-stat bg-danger text-white">
                    <h6>Total Sold</h6>
                    <h3>@Model.Sum(x => x.TotalSold)</h3>
                </div>
            </div>
        </div>
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Purchased</th>
                    <th>Sold</th>
                    <th>Stock</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ItemCode</td>
                        <td>@item.ItemName</td>
                        <td>₱@item.ItemPrice.ToString("N2")</td>
                        <td>@item.TotalPurchased</td>
                        <td>@item.TotalSold</td>
                        <td>
                            @if (item.CurrentStock <= 0)
                            {
                                <span class="badge rounded-pill bg-danger px-3 py-2">
                                    Out of Stock
                                </span>
                            }
                            else if (item.CurrentStock <= 5)
                            {
                                <span class="badge rounded-pill bg-warning text-dark px-3 py-2">
                                    Low (@item.CurrentStock)
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-success px-3 py-2">
                                    @item.CurrentStock Units
                                </span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-1" role="group">
                                <button type="button"
                                        class="btn btn-warning btn-sm editItemBtn"
                                        data-id="@item.Id"
                                        data-code="@item.ItemCode"
                                        data-name="@item.ItemName"
                                        data-price="@item.ItemPrice"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editModal"
                                        title="Edit Item">
                                    <i class="bi bi-pencil-square"></i>
                                </button>

                                <form asp-action="Delete"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  class="d-inline">

                                   @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger btn-sm"
                                            title="Delete Item"
                                            onclick="return confirm('Delete this item?');">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Section -->

<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-action="Edit" method="post">

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Edit Item</h5>
                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <input type="hidden" id="EditId" name="Id" />

                    <div class="mb-3">
                        <label class="form-label">Item Code</label>
                        <input type="text"
                               id="EditCode"
                               name="ItemCode"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Item Name</label>
                        <input type="text"
                               id="EditName"
                               name="ItemName"
                               class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Item Price</label>
                        <input type="number"
                               step="0.01"
                               id="EditPrice"
                               name="ItemPrice"
                               class="form-control" />
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Close
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

                
@section Scripts {
    <script src="~/js/item/index.js"></script>
}