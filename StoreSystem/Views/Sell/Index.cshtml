
@{
    ViewData["Title"] = "Sell";
}

<link href="~/css/sell/index.css" rel="stylesheet" />

<div class="card recent-sales-card border-0 shadow-lg">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h3 class="mb-0 text-white">
                <i class="bi bi-cart-check me-2"></i>
                Recent Sales
            </h3>
            <small class="text-light">Latest transactions</small>
        </div>
        <a asp-controller="Sell"
           asp-action="Create"
           class="btn btn-light btn-sm px-3">
            <i class="bi bi-plus-circle me-1"></i>
            New Sale
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="sellTable" 
                   class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Quantity</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/sell/index.js"></script>
}