
@{
    ViewData["Title"] = "Purchase";
}

<link href="~/css/purchase/index.css" rel="stylesheet" />

<div class="card purchase-card border-0 shadow-lg">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h3 class="mb-0 text-white">
                <i class="bi bi-bag-plus-fill me-2"></i>
                Recent Purchases
            </h3>
            <small class="text-light">Latest stock replenishment transactions</small>
        </div>
        <a asp-controller="Purchase"
            asp-action="Create"
            class="btn btn-light btn-sm px-3">
            <i class="bi bi-plus-circle me-1"></i>
            New Purchase
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="purchaseTable" 
                   class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Quantity</th>
                        <th>Purchase Date</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/purchase/index.js"></script>
}