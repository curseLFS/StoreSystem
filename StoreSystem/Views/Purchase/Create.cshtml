@using StoreSystem.DAL.Models
@model Purchase

@{
    ViewData["Title"] = "Purchase[Create]";
}

<link rel="stylesheet"
      href="~/css/purchase.css"
      asp-append-version="true" />

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card purchase-card border-0 shadow-lg">

            <div class="card-header purchase-header">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <h3 class="mb-1">
                            <i class="bi bi-bag-plus-fill me-2"></i>
                            Purchase Item
                        </h3>

                        <small>Add stock to inventory</small>
                    </div>

                    <span class="badge bg-light text-dark px-3 py-2">
                        Inventory Replenishment
                    </span>

                </div>

            </div>

            <div class="card-body p-4">

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="All"
                         class="alert alert-danger">
                    </div>

                    <div class="row g-4">

                        <!-- Item -->
                        <div class="col-md-12">

                            <label class="form-label fw-semibold">
                                <i class="bi bi-box-seam me-1"></i>
                                Item
                            </label>

                            <select asp-for="ItemId"
                                    asp-items="ViewBag.Items"
                                    class="form-select form-select-lg">

                                <option value="">
                                    Select Item
                                </option>

                            </select>

                        </div>

                        <!-- Quantity -->
                        <div class="col-md-6">

                            <label asp-for="Quantity"
                                   class="form-label fw-semibold">
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-stack"></i>
                                </span>

                                <input asp-for="Quantity"
                                       class="form-control form-control-lg"
                                       placeholder="Enter quantity" />

                            </div>

                        </div>

                        <!-- Date -->
                        <div class="col-md-6">

                            <label class="form-label fw-semibold"> 
                                Purchase Date
                            </label>

                            <input asp-for="PurchaseDate"
                                   type="date"
                                   class="form-control form-control-lg"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")" />

                        </div>

                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end gap-2">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-left"></i>
                            Back

                        </a>

                        <button type="submit"
                                class="btn btn-success btn-lg">

                            <i class="bi bi-check-circle-fill me-2"></i>
                            Complete Purchase

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>